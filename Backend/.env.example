# Server Configuration
NODE_ENV=development
PORT=5000
HOST=localhost

# Database
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/CARGOFLEET?retryWrites=true&w=majority

# JWT
JWT_SECRET=your_jwt_secret_key_here_min_32_chars
JWT_EXPIRY=15m
JWT_REFRESH_SECRET=your_refresh_secret_here_min_32_chars
JWT_REFRESH_EXPIRY=30d

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:5000/api/auth/google/callback
# Mobile app's platform-specific OAuth clients (see App/ - Android's client is tied to its
# signing certificate, so it can't reuse the web client above). Optional; only needed once
# the mobile app's Google sign-in is wired up.
GOOGLE_ANDROID_CLIENT_ID=
GOOGLE_IOS_CLIENT_ID=

# Cloudinary (file storage)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_FOLDER=cargofleet

# Super Admin Configuration (3 slots available)
# Passwords are plaintext here - the app hashes them in memory at startup (see src/config/environment.ts).
SUPER_ADMIN_1_EMAIL=admin1@cargofleet.co.ke
SUPER_ADMIN_1_PASSWORD=your_super_admin_password_here
SUPER_ADMIN_1_SECRET_CODE=1234

SUPER_ADMIN_2_EMAIL=admin2@cargofleet.co.ke
SUPER_ADMIN_2_PASSWORD=your_super_admin_password_here
SUPER_ADMIN_2_SECRET_CODE=5678

SUPER_ADMIN_3_EMAIL=admin3@cargofleet.co.ke
SUPER_ADMIN_3_PASSWORD=your_super_admin_password_here
SUPER_ADMIN_3_SECRET_CODE=9012

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173

# WebSocket
SOCKET_IO_CORS_ORIGIN=http://localhost:5173

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# File Upload
MAX_FILE_SIZE=10485760
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/webp

# Logging
LOG_LEVEL=info

# Timezone
TZ=Africa/Nairobi
