# Backend API (deployed Render URL, or your machine's LAN IP for local dev - "localhost"
# does not work from a physical phone running Expo Go)
EXPO_PUBLIC_API_URL=http://localhost:5000/api
EXPO_PUBLIC_SOCKET_URL=http://localhost:5000

# Android OAuth client ID from Google Cloud Console (Application type: Android, package
# ke.co.cargofleet.driver, SHA-1 from `eas credentials` / the Expo dashboard's Credentials page)
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
